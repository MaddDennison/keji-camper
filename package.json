{
  "name": "keji-camper",
  "private": true,
  "version": "0.1.0",
  "description": "An unofficial backcountry trip journal, planner and night-sky companion for Kejimkujik National Park",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "data:geo": "python3 scripts/build_geo.py",
    "data:alt": "python3 scripts/build_alt_routes.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
