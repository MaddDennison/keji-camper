{
  "name": "keji-camper",
  "private": true,
  "version": "0.1.0",
  "description": "An unofficial backcountry trip journal, planner and night-sky companion for Kejimkujik National Park",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "data:geo": "python3 scripts/build_geo.py",
    "data:alt": "python3 scripts/build_alt_routes.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "~5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
